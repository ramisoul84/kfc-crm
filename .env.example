# ─── Application ───
APP_NAME=kfc-crm
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true

# ─── HTTP Server ───
HTTP_PORT=8000
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# ─── Logger ───
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_OUTPUT=stdout
LOG_FILE_PATH=logs/app.log
LOG_SERVICE=kfc-crm